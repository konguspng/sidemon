<win:AppBarWindow
        x:Class="SidebarDiagnostics.Sidebar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SidebarDiagnostics"
        xmlns:frame="clr-namespace:SidebarDiagnostics.Framework"
        xmlns:monitor="clr-namespace:SidebarDiagnostics.Monitoring"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
         xmlns:conv="clr-namespace:SidebarDiagnostics.Converters"
        xmlns:win="clr-namespace:SidebarDiagnostics.Windows"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        Closed="Window_Closed"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Style="{StaticResource SidebarWindow}"
        Opacity="0">
        <win:AppBarWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <Storyboard x:Key="SkeletonStoryboard" RepeatBehavior="Forever">
                    <DoubleAnimation
                        Storyboard.TargetName="ShimmerStop"
                        Storyboard.TargetProperty="Offset"
                        From="-1.2" To="1.2" Duration="0:0:1.8" />
                </Storyboard>
            </win:AppBarWindow.Resources>
            <Grid x:Name="LayoutRoot">
                <!-- Background layer: solid tint, or (glass mode) an invisible fill over the real
                     Windows acrylic blur that the window itself provides -->
                <Border x:Name="BackgroundBorder" />

                <!-- Loading skeleton: shows only while the sidebar is initializing/reloading.
                             Elegant multi-element shimmer: gray rounded rectangles mimic content structure,
                             a subtle white shimmer sweeps across from left to right. Hidden when Ready=true. -->
                                <Grid x:Name="SkeletonPanel"
                                      Margin="10,10,0,0">
                                    <StackPanel Style="{StaticResource ContentPanel}">
                                        <!-- Header card -->
                                        <Border Style="{StaticResource GroupCard}" Margin="0,0,0,18">
                                            <StackPanel Style="{StaticResource GroupPanel}" Margin="16,14">
                                                <Rectangle Width="200" Height="20" RadiusX="4" RadiusY="4" Fill="#E8E8E8" />
                                                <Rectangle Width="120" Height="15" RadiusX="2" RadiusY="2" Margin="0,10,0,0" Fill="#E8E8E8" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Time card -->
                                        <Border Style="{StaticResource GroupCard}" Margin="0,0,0,18">
                                            <StackPanel Style="{StaticResource GroupPanel}" Margin="16,14">
                                                <Rectangle Width="100" Height="20" RadiusX="4" RadiusY="4" Fill="#E8E8E8" />
                                                <Rectangle Width="60" Height="14" RadiusX="2" RadiusY="2" Margin="0,10,0,0" Fill="#E8E8E8" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Monitor panel rows -->
                                        <ItemsControl ItemsSource="{Binding Source={x:Static sys:Int32.MaxValue}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Style="{StaticResource VerticalPanel}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource GroupCard}" Margin="0,0,0,14">
                                                        <StackPanel Style="{StaticResource GroupPanel}" Margin="16,12">
                                                            <Rectangle Width="160" Height="18" RadiusX="4" RadiusY="4" Fill="#E8E8E8" />
                                                            <Rectangle Width="260" Height="15" RadiusX="2" RadiusY="2" Margin="0,10,0,0" Fill="#E8E8E8" />
                                                            <Rectangle Width="180" Height="13" RadiusX="2" RadiusY="2" Margin="0,8,0,0" Fill="#E8E8E8" />
                                                            <Rectangle Width="110" Height="11" RadiusX="2" RadiusY="2" Margin="0,8,0,0" Fill="#E8E8E8" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Sweeping shimmer overlay -->
                                    <Border x:Name="ShimmerOverlay" Background="#FFFFFF" Opacity="0.45">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush x:Name="ShimmerBrush" StartPoint="-1,0" EndPoint="2,0">
                                                <GradientStop x:Name="ShimmerStop" Offset="-1" Color="Transparent" />
                                                <GradientStop Offset="-0.4" Color="White" />
                                                <GradientStop Offset="0" Color="Transparent" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>

                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Grid.Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource SkeletonStoryboard}" />
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>
        
        <DockPanel x:Name="MainContent" Style="{StaticResource MainPanel}">
            <StackPanel x:Name="WindowControls" Style="{StaticResource MenuBar}">
                <Button Click="GraphButton_Click" Style="{StaticResource MenuButton}">
                    <Path Width="12" Height="12" Data="M3 3v18h18 M7 15l4-5 3 3 5-7" />
                </Button>
                
                <Button Click="SettingsButton_Click" Style="{StaticResource MenuButton}">
                    <Path Width="12" Height="12" Data="M21 4h-7 M10 4H3 M21 12h-9 M8 12H3 M21 20h-5 M12 20H3 M14 2v4 M8 10v4 M16 18v4" />
                </Button>

                <Button Click="CloseButton_Click" Style="{StaticResource MenuButton}">
                    <Path Width="12" Height="12" Data="M18 6 6 18 M6 6l12 12" />
                </Button>
            </StackPanel>

            <!-- No scrolling and no local scaling here: when content would overflow
                 the screen, Sidebar.xaml.cs measures it and writes the scale needed
                 to fit into the real UIScale setting (Advanced tab), which the
                 window already knows how to apply to everything, sidebar-wide. -->
            <Border Margin="5,15" VerticalAlignment="{Binding Source={x:Static frame:Settings.Instance}, Path=ContentVerticalAlign, Mode=OneWay}">
                <StackPanel x:Name="ContentStack" Style="{StaticResource ContentPanel}">
                    <TextBlock Text="{Binding Path=MonitorManager.HardwareLimitedReason}" Visibility="{Binding Path=MonitorManager.HardwareLimited, Converter={StaticResource BoolToVisibility}}" Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10" Style="{StaticResource DataText}" />
                    <ContentControl>
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=ShowMachineName, Mode=OneWay}" Value="True">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel Style="{StaticResource HeaderPanel}">
                                                    <Label Content="{Binding Path=MachineName, Mode=OneWay}" Style="{StaticResource AppTitle}" />
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    
                    <ContentControl>
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=ShowClock, Mode=OneWay}" Value="True">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Border Style="{StaticResource GroupCard}">
                                                <StackPanel Style="{StaticResource GroupPanel}">
                                                    <StackPanel Style="{StaticResource MonitorTitle}">
                                                        <Path Style="{StaticResource AppIcon}" Data="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z M12 7v5l3 2"></Path>
                                                        <Label Content="{x:Static frame:Resources.Time}" Style="{StaticResource AppTitle}" />
                                                    </StackPanel>
                                                    
                                                    <StackPanel Style="{StaticResource MonitorPanel}">
                                                        <Label Content="{Binding Path=Time, Mode=OneWay}" Style="{StaticResource AppTitle}" />
                                                        <ContentControl>
                                                            <ContentControl.Style>
                                                                <Style TargetType="{x:Type ContentControl}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Path=ShowDate, Mode=OneWay}" Value="True">
                                                                            <Setter Property="Content">
                                                                                <Setter.Value>
                                                                                    <TextBlock Text="{Binding Path=Date, Mode=OneWay}" Margin="0,4,0,0" Style="{StaticResource AppText}" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                    </StackPanel>
                                                </StackPanel>
                                                </Border>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <ItemsControl DataContext="{Binding Path=MonitorManager, Mode=OneWay}" ItemsSource="{Binding Path=MonitorPanels, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type monitor:MonitorPanel}">
                                <Border Style="{StaticResource GroupCard}">
                                <StackPanel Style="{StaticResource GroupPanel}">
                                    <StackPanel Style="{StaticResource MonitorTitle}">
                                        <Path Data="{Binding Path=IconPath, Mode=OneWay}" Style="{StaticResource AppIcon}" />
                                        <Label Content="{Binding Path=Title, Mode=OneWay}" Style="{StaticResource AppTitle}" />
                                    </StackPanel>
                                    
                                    <ItemsControl ItemsSource="{Binding Path=Monitors, Mode=OneWay}">
                                        <ItemsControl.Resources>
                                            <DataTemplate DataType="{x:Type monitor:BaseMonitor}">
                                                <StackPanel Style="{StaticResource MonitorPanel}">
                                                    <ContentControl>
                                                        <ContentControl.Style>
                                                            <Style TargetType="{x:Type ContentControl}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=ShowName, Mode=OneWay}" Value="True">
                                                                        <Setter Property="Content">
                                                                            <Setter.Value>
                                                                                <TextBlock Text="{Binding Path=Name, Mode=OneWay}" Style="{StaticResource HardwareText}" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                    
                                                    <ItemsControl ItemsSource="{Binding Path=Metrics, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type monitor:iMetric}">
                                                                <StackPanel Style="{StaticResource VerticalPanel}">
                                                                    <DockPanel Style="{StaticResource MetricPanel}">
                                                                        <TextBlock Text="{Binding Path=Label, Mode=OneWay, Converter={StaticResource MetricLabelConverter}}" Style="{StaticResource MetricLabel}" />
                                                                        <TextBlock Text="{Binding Path=Text, Mode=OneWay}" Style="{StaticResource MetricValue}" />
                                                                    </DockPanel>
                                                                    <ProgressBar Value="{Binding Path=nValue, Mode=OneWay}" Style="{StaticResource AccentBar}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Style="{StaticResource VerticalPanel}" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type monitor:UsageMonitor}">
                                                <StackPanel Style="{StaticResource MonitorPanel}">
                                                    <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                                        <Button DockPanel.Dock="Right"
                                                                Command="{Binding SignInCommand}"
                                                                ToolTip="{x:Static frame:Resources.UsageSignInTooltip}"
                                                                Visibility="{Binding SignInButtonVisibility}"
                                                                Style="{StaticResource IconButton}"
                                                                Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <Path Width="10" Height="10" Data="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4 M10 17l5-5-5-5 M15 12H3" />
                                                        </Button>
                                                        <TextBlock Text="{Binding Path=Name, Mode=OneWay}" Style="{StaticResource HardwareText}" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>

                                                    <ItemsControl ItemsSource="{Binding Path=Metrics, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type monitor:UsageMetric}">
                                                                <StackPanel Style="{StaticResource VerticalPanel}" Margin="0,0,0,4" Opacity="{Binding Path=RowOpacity, Mode=OneWay}">
                                                                    <DockPanel Style="{StaticResource MetricPanel}">
                                                                        <TextBlock Text="{Binding Path=Label, Mode=OneWay}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource MetricLabel}" />
                                                                        <TextBlock Text="{Binding Path=Text, Mode=OneWay}" TextWrapping="NoWrap" Style="{StaticResource MetricValue}" />
                                                                    </DockPanel>
                                                                    <ProgressBar Value="{Binding Path=nValue, Mode=OneWay}" Style="{StaticResource AccentBar}" />
                                                                    <TextBlock Text="{Binding Path=ResetText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.6">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AppText}">
                                                                                <Setter Property="Margin" Value="0,1,0,0" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Path=ResetText, Mode=OneWay}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Source={x:Static frame:Settings.Instance}, Path=TextAlign, Mode=OneWay}" Value="Right">
                                                                                        <Setter Property="TextAlignment" Value="Right" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Style="{StaticResource VerticalPanel}" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type monitor:DriveMonitor}">
                                                <StackPanel Style="{StaticResource MonitorPanel}">
                                                    <ContentControl>
                                                        <ContentControl.Style>
                                                            <Style TargetType="{x:Type ContentControl}">
                                                                <Setter Property="Content">
                                                                    <Setter.Value>
                                                                        <TextBlock Text="{Binding Path=Name, Mode=OneWay}" Style="{StaticResource DataText}" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=Status, Mode=OneWay}" Value="LoadBarStacked">
                                                                        <Setter Property="Content">
                                                                            <Setter.Value>
                                                                                <StackPanel Style="{StaticResource VerticalPanel}">
                                                                                    <TextBlock Text="{Binding Path=Name, Mode=OneWay}" Style="{StaticResource DataText}" />
                                                                                    <ProgressBar DataContext="{Binding Path=LoadMetric}" Value="{Binding Path=Value, Mode=OneWay}" Style="{StaticResource DriveProgress}" />
                                                                                </StackPanel>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                    
                                                                    <DataTrigger Binding="{Binding Path=Status, Mode=OneWay}" Value="LoadBarInline">
                                                                        <Setter Property="Content">
                                                                            <Setter.Value>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding Path=Name, Mode=OneWay}" Width="{Binding Source={x:Static frame:Settings.Instance}, Path=FontSetting.FontSize, Mode=OneWay}" Style="{StaticResource DataText}" />
                                                                                    <ProgressBar DataContext="{Binding Path=LoadMetric}" Value="{Binding Path=Value, Mode=OneWay}" Margin="8,2,0,0" Width="{Binding Source={x:Static frame:Settings.Instance}, Path=FontSetting.BarWidth, Mode=OneWay}" Style="{StaticResource DriveProgress}" />
                                                                                </StackPanel>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>

                                                    <ItemsControl ItemsSource="{Binding Path=DriveMetrics, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type monitor:iMetric}">
                                                                <StackPanel Style="{StaticResource VerticalPanel}">
                                                                    <DockPanel Style="{StaticResource MetricPanel}">
                                                                        <TextBlock Text="{Binding Path=Label, Mode=OneWay, Converter={StaticResource MetricLabelConverter}}" Style="{StaticResource MetricLabel}" />
                                                                        <TextBlock Text="{Binding Path=Text, Mode=OneWay}" Style="{StaticResource MetricValue}" />
                                                                    </DockPanel>
                                                                    <ProgressBar Value="{Binding Path=nValue, Mode=OneWay}" Style="{StaticResource AccentBar}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Style="{StaticResource VerticalPanel}" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.Resources>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Style="{StaticResource VerticalPanel}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Style="{StaticResource VerticalPanel}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</win:AppBarWindow>