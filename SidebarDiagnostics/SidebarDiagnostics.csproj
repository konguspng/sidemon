<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SidebarDiagnostics</RootNamespace>
    <AssemblyName>SideMon</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>Sidebar.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <StartupObject>SidebarDiagnostics.App</StartupObject>
    <SatelliteResourceLanguages>en;da;de;fr;ja;nl;zh;it;ru;fi;es;ar;tr</SatelliteResourceLanguages>

    <!-- the compiler embeds source file paths (as seen on the build machine) into the
         pdb, and that pdb ships to every user in the installer; rewrite the absolute
         build path to a generic one so crash logs don't leak the developer's local
         folder structure -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=SidebarDiagnostics</PathMap>
    <PublishSelfContained>true</PublishSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- the SDK also auto-embeds a source-link block (repo-relative git metadata for
         IDE debugging) that separately carries the raw local build path; this app
         ships no source-server support to end users, so turn the query off rather
         than let that block reintroduce the same leak PathMap just closed -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <DefineConstants Condition="Exists('ReportSecret.cs')">$(DefineConstants);HAS_REPORT_SECRET</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Sidebar.ico" />
    <Resource Include="Settings.ico" />
    <Resource Include="Fonts\BarlowCondensed-Bold.ttf" />
    <Resource Include="Fonts\BarlowCondensed-Regular.ttf" />
    <Resource Include="Fonts\ChakraPetch-Bold.ttf" />
    <Resource Include="Fonts\ChakraPetch-Regular.ttf" />
    <Resource Include="Fonts\Exo2-Bold.ttf" />
    <Resource Include="Fonts\Exo2-Regular.ttf" />
    <Resource Include="Fonts\Inter-Bold.ttf" />
    <Resource Include="Fonts\Inter-Regular.ttf" />
    <Resource Include="Fonts\JetBrainsMono-Bold.ttf" />
    <Resource Include="Fonts\JetBrainsMono-Regular.ttf" />
    <Resource Include="Fonts\Oxanium-Bold.ttf" />
    <Resource Include="Fonts\Oxanium-Regular.ttf" />
    <Resource Include="Fonts\Rajdhani-Bold.ttf" />
    <Resource Include="Fonts\Rajdhani-Regular.ttf" />
    <Resource Include="Fonts\ShareTechMono-Regular.ttf" />
    <Resource Include="Fonts\TitilliumWeb-Bold.ttf" />
    <Resource Include="Fonts\TitilliumWeb-Regular.ttf" />
    <None Include="ChangeLog.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
