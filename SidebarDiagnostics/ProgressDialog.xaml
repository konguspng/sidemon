<Window x:Class="SidebarDiagnostics.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SideMon"
        Width="320"
        Height="110"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText" Grid.Row="0" Text="Working..." TextWrapping="Wrap" Margin="0,0,0,12" />
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="6" />
    </Grid>
</Window>
