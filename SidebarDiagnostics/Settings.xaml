<sty:FlatWindow
        x:Class="SidebarDiagnostics.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SidebarDiagnostics"
        xmlns:monitor="clr-namespace:SidebarDiagnostics.Monitoring"
        xmlns:conv="clr-namespace:SidebarDiagnostics.Converters"
        xmlns:win="clr-namespace:SidebarDiagnostics.Windows"
        xmlns:sty="clr-namespace:SidebarDiagnostics.Style"
        xmlns:frame="clr-namespace:SidebarDiagnostics.Framework"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        Title="{x:Static frame:Resources.SettingsTitle}"
        Icon="Sidebar.ico"
        Width="1000"
        Height="740"
        MinWidth="820"
        MinHeight="520"
        ShowMaximize="False"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#EEF0F3"
        BorderBrush="#C9CDD2"
        Foreground="#1A1A1A"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        Style="{StaticResource FlatWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:IntToStringConverter x:Key="IntConverter" />
            <conv:HotkeyToStringConverter x:Key="HotkeyConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:ProviderIconGeometryConverter x:Key="ProviderGeometry" />
            <conv:ProviderIconBrushConverter x:Key="ProviderBrush" />
            <conv:NullToCollapsedConverter x:Key="EmptyToCollapsed" />

            <Style x:Key="PageScroll" TargetType="{x:Type ScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Padding" Value="32,26,24,24" />
            </Style>
            <Style x:Key="PageBody" TargetType="{x:Type StackPanel}">
                <Setter Property="MaxWidth" Value="820" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="NumBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="64" />
                <Setter Property="Margin" Value="12,0,0,0" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
            <Style x:Key="Swatch" TargetType="{x:Type Border}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderBrush" Value="#33000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="ColorBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="112" />
                <Setter Property="FontFamily" Value="Consolas" />
            </Style>
            <Style x:Key="ClaudeOnly" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=ID}" Value="AIUsage_Claude">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <DockPanel x:Name="MainContentPanel" LastChildFill="True">
        <!-- ===== sticky footer ===== -->
        <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="20,12" CornerRadius="0,0,5,5">
            <DockPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="CloseButton_Click" MinWidth="96" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="{x:Static frame:Resources.ButtonClose}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsChanged, Mode=OneWay}" Value="True">
                                        <Setter Property="Content" Value="{x:Static frame:Resources.ButtonCancel}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{x:Static frame:Resources.ButtonApply}" IsEnabled="{Binding Path=IsChanged, Mode=OneWay}" Click="ApplyButton_Click" MinWidth="96" Margin="0,0,8,0" />
                    <Button Content="{x:Static frame:Resources.ButtonSave}" Click="SaveButton_Click" MinWidth="96" Style="{StaticResource AccentButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="SettingsTabControl" Style="{StaticResource NavTabs}" Background="Transparent" BorderThickness="0">

            <!-- ================= GENERAL ================= -->
            <TabItem Header="{x:Static frame:Resources.SettingsGeneralTab}" Tag="&#xE713;">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="{x:Static frame:Resources.SettingsGeneralTab}" Style="{StaticResource PageTitle}" />

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupApp}" Style="{StaticResource GroupHeader}" Margin="2,0,0,8" />
                        <local:SettingRow Icon="&#xE774;" Header="{x:Static frame:Resources.SettingsLanguage}" Description="{x:Static frame:Resources.SettingsLanguageTooltip}">
                            <ComboBox Width="220" ItemsSource="{Binding Path=CultureItems, Mode=OneWay}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding Path=Culture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE7E8;" Header="{x:Static frame:Resources.SettingsRunAtStartup}" Description="{x:Static frame:Resources.SettingsRunAtStartupTooltip}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=RunAtStartup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE7C4;" Header="{x:Static frame:Resources.SettingsShowTrayIcon}" Description="{x:Static frame:Resources.SettingsShowTrayIconTooltip}">
                            <CheckBox Style="{StaticResource Switch}" x:Name="ShowTrayIconCheckbox" Unchecked="ShowTrayIconCheckbox_Unchecked" IsChecked="{Binding Path=ShowTrayIcon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE916;" Header="{x:Static frame:Resources.SettingsPollingInterval}" Description="{x:Static frame:Resources.SettingsPollingIntervalTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="PollingIntervalSlider" Value="{Binding Path=PollingInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="100" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True" LargeChange="1000" />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding ElementName=PollingIntervalSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" PreviewTextInput="NumberBox_PreviewTextInput" />
                                <TextBlock Text="ms" Style="{StaticResource Unit}" />
                            </StackPanel>
                        </local:SettingRow>

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupHardwareSensors}" Style="{StaticResource GroupHeader}" />
                        <local:SettingRow Icon="&#xE950;" Header="{x:Static frame:Resources.SettingsUiPawnIOHeader}">
                            <local:SettingRow.Style>
                                <Style TargetType="{x:Type local:SettingRow}" BasedOn="{StaticResource {x:Type local:SettingRow}}">
                                    <Setter Property="Description" Value="{x:Static frame:Resources.SettingsUiPawnIOMissingDesc}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=PawnIODriverInstalled}" Value="True">
                                            <Setter Property="Description" Value="{x:Static frame:Resources.SettingsUiPawnIOAvailableDesc}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:SettingRow.Style>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding Path=PawnIODriverInstalled, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <ProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0" Visibility="{Binding Path=PawnIODriverInstalling, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{x:Static frame:Resources.SettingsUiInstallDriver}" Style="{StaticResource AccentButton}" Click="InstallPawnIO_Click" IsEnabled="{Binding Path=PawnIODriverInstalling, Converter={StaticResource BoolInverseConverter}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding Path=PawnIODriverInstalled, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" Foreground="#0F7B0F" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static frame:Resources.SettingsUiInstalled}" Foreground="#0F7B0F" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </local:SettingRow>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= LAYOUT ================= -->
            <TabItem Header="{x:Static frame:Resources.SettingsAdvancedTab}" Tag="&#xE7F4;">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="{x:Static frame:Resources.SettingsAdvancedTab}" Style="{StaticResource PageTitle}" />

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupPosition}" Style="{StaticResource GroupHeader}" Margin="2,0,0,8" />
                        <local:SettingRow Icon="&#xE7F4;" Header="{x:Static frame:Resources.SettingsScreen}" Description="{x:Static frame:Resources.SettingsScreenTooltip}">
                            <ComboBox Width="220" ItemsSource="{Binding Path=ScreenItems, Mode=OneWay}" DisplayMemberPath="Text" SelectedValuePath="Index" SelectedValue="{Binding Path=ScreenIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE90C;" Header="{x:Static frame:Resources.SettingsDock}" Description="{x:Static frame:Resources.SettingsDockTooltip}">
                            <ComboBox Width="220" ItemsSource="{Binding Path=DockEdgeItems, Mode=OneWay}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding Path=DockEdge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE7C2;" Header="{x:Static frame:Resources.SettingsUiOffsetHeader}" Description="{x:Static frame:Resources.SettingsUiOffsetDesc}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="X" Style="{StaticResource Unit}" Margin="0,0,10,0" MinWidth="0" ToolTip="{x:Static frame:Resources.SettingsHorizontalOffset}" />
                                    <Slider x:Name="XOffsetSlider" Value="{Binding Path=XOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-2000" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True" LargeChange="100" ValueChanged="OffsetSlider_ValueChanged" ToolTip="{x:Static frame:Resources.SettingsHorizontalOffsetTooltip}" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding ElementName=XOffsetSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" PreviewTextInput="NumberBox_PreviewTextInput" />
                                    <TextBlock Text="px" Style="{StaticResource Unit}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Y" Style="{StaticResource Unit}" Margin="0,0,10,0" MinWidth="0" ToolTip="{x:Static frame:Resources.SettingsVerticalOffset}" />
                                    <Slider x:Name="YOffsetSlider" Value="{Binding Path=YOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-2000" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True" LargeChange="100" ValueChanged="OffsetSlider_ValueChanged" ToolTip="{x:Static frame:Resources.SettingsVerticalOffsetTooltip}" />
                                    <TextBox Style="{StaticResource NumBox}" Text="{Binding ElementName=YOffsetSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" PreviewTextInput="NumberBox_PreviewTextInput" />
                                    <TextBlock Text="px" Style="{StaticResource Unit}" />
                                </StackPanel>
                            </StackPanel>
                        </local:SettingRow>

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupSize}" Style="{StaticResource GroupHeader}" />
                        <local:SettingRow Icon="&#xE8A9;" Header="{x:Static frame:Resources.SettingsSidebarWidth}" Description="{x:Static frame:Resources.SettingsSidebarWidthTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="SidebarWidthSlider" Value="{Binding Path=SidebarWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="100" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" LargeChange="50" />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding ElementName=SidebarWidthSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" PreviewTextInput="NumberBox_PreviewTextInput" />
                                <TextBlock Text="px" Style="{StaticResource Unit}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE71E;" Header="{x:Static frame:Resources.SettingsUIScale}" Description="{x:Static frame:Resources.SettingsUIScaleTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="UIScaleSlider" Value="{Binding Path=UIScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="3.0" TickFrequency="0.05" IsSnapToTickEnabled="True" LargeChange="0.25" />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding ElementName=UIScaleSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" PreviewTextInput="NumberBox_PreviewTextInput" />
                                <TextBlock Text="x" Style="{StaticResource Unit}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE740;" Header="{x:Static frame:Resources.SettingsUiFitToScreenHeader}" Description="{x:Static frame:Resources.SettingsUiFitToScreenDesc}">
                            <StackPanel Orientation="Horizontal">
                                <Button Click="FitToScreen_Click" Margin="0,0,16,0" ToolTip="{x:Static frame:Resources.SettingsUiFitNowTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE740;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static frame:Resources.SettingsUiFitNow}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=AutoFitScale}" ToolTip="{x:Static frame:Resources.SettingsAutoFitScaleTooltip}" />
                            </StackPanel>
                        </local:SettingRow>
                        <Border BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,4" Background="#FFF4CE" BorderBrush="#F2DFA0">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=AutoFitScale, Mode=OneWay}" Value="True" />
                                                <Condition Binding="{Binding Path=UIScaleCapped, Mode=OneWay}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Glyph}" Foreground="#8A5300" Margin="0,0,10,0" />
                                <TextBlock TextWrapping="Wrap" Foreground="#5C3B00">
                                    <TextBlock.Text>
                                        <Binding Path="MaxUIScale" Mode="OneWay" StringFormat="{x:Static frame:Resources.SettingsUiAutoFitCappedFormat}" />
                                    </TextBlock.Text>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupBehavior}" Style="{StaticResource GroupHeader}" />
                        <local:SettingRow Icon="&#xE718;" Header="{x:Static frame:Resources.SettingsReserveSpace}" Description="{x:Static frame:Resources.SettingsReserveSpaceTooltip}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=UseAppBar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE8A7;" Header="{x:Static frame:Resources.SettingsAlwaysOnTop}" IsEnabled="{Binding Path=BGModeBlur, Mode=OneWay, Converter={StaticResource BoolInverseConverter}}">
                            <local:SettingRow.Style>
                                <Style TargetType="{x:Type local:SettingRow}" BasedOn="{StaticResource {x:Type local:SettingRow}}">
                                    <Setter Property="Description" Value="{x:Static frame:Resources.SettingsAlwaysOnTopTooltip}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=BGModeBlur}" Value="True">
                                            <Setter Property="Description" Value="{x:Static frame:Resources.SettingsUiAlwaysTopBlurDesc}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:SettingRow.Style>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=AlwaysTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE8B0;" Header="{x:Static frame:Resources.SettingsClickThrough}" Description="{x:Static frame:Resources.SettingsClickThroughTooltip}">
                            <CheckBox Style="{StaticResource Switch}" x:Name="ClickThroughCheckbox" Checked="ClickThroughCheckbox_Checked" IsChecked="{Binding Path=ClickThrough, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xED1A;" Header="{x:Static frame:Resources.SettingsInitiallyHidden}" Description="{x:Static frame:Resources.SettingsInitiallyHiddenTooltip}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=InitiallyHidden, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE73F;" Header="{x:Static frame:Resources.SettingsCollapseMenuBar}" Description="{x:Static frame:Resources.SettingsCollapseMenuBarTooltip}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=CollapseMenuBar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= APPEARANCE ================= -->
            <TabItem Header="{x:Static frame:Resources.SettingsCustomizeTab}" Tag="&#xE771;">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="{x:Static frame:Resources.SettingsCustomizeTab}" Style="{StaticResource PageTitle}" />

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupBackground}" Style="{StaticResource GroupHeader}" Margin="2,0,0,8" />
                        <local:SettingRow Icon="&#xE771;" Header="{x:Static frame:Resources.SettingsUiBgStyleHeader}" Description="{x:Static frame:Resources.SettingsUiBgStyleDesc}">
                            <Border Background="#0A000000" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BGMode" Content="{x:Static frame:Resources.SettingsUiBgSolid}" IsChecked="{Binding Path=BGModeSolid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static frame:Resources.SettingsUiBgSolidTooltip}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BGMode" Content="{x:Static frame:Resources.SettingsUiBgAccent}" IsChecked="{Binding Path=BGModeAccent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static frame:Resources.SettingsUiBgAccentTooltip}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="BGMode" Content="{x:Static frame:Resources.SettingsUiBgAcrylic}" IsChecked="{Binding Path=BGModeBlur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static frame:Resources.SettingsUiBgAcrylicTooltip}" />
                                </StackPanel>
                            </Border>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE790;" Header="{x:Static frame:Resources.SettingsUiBgColorHeader}" Description="{x:Static frame:Resources.SettingsUiBgColorDesc}" IsEnabled="{Binding Path=BGModeAccent, Mode=OneWay, Converter={StaticResource BoolInverseConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Swatch}" Background="{Binding Path=BGColor, Mode=OneWay}" Tag="BGColor" MouseLeftButtonDown="ColorBorder_MouseLeftButtonDown" ToolTip="{x:Static frame:Resources.SettingsUiPickColorTooltip}" />
                                <TextBox Style="{StaticResource ColorBox}" Text="{Binding Path=BGColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE706;" Header="{x:Static frame:Resources.SettingsUiOpacityHeader}" Description="{x:Static frame:Resources.SettingsUiBgOpacityDesc}">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="BGOpacitySlider" Value="{Binding Path=BGOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.01" Maximum="1.0" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True" />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding ElementName=BGOpacitySlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" PreviewTextInput="NumberBox_PreviewTextInput" />
                                <TextBlock Text="" Style="{StaticResource Unit}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE9CA;" Header="{x:Static frame:Resources.SettingsUiBlurAmountHeader}" Description="{x:Static frame:Resources.SettingsUiBlurAmountDesc}" IsEnabled="{Binding Path=BGModeBlur, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="GlassBlurAmountSlider" Value="{Binding Path=GlassBlurAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.0" Maximum="1.0" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True" />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding ElementName=GlassBlurAmountSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" PreviewTextInput="NumberBox_PreviewTextInput" />
                                <TextBlock Text="" Style="{StaticResource Unit}" />
                            </StackPanel>
                        </local:SettingRow>

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupPanels}" Style="{StaticResource GroupHeader}" />
                        <local:SettingRow Icon="&#xF0E2;" Header="{x:Static frame:Resources.SettingsUiCardPanelsHeader}" Description="{x:Static frame:Resources.SettingsUiCardPanelsDesc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=UseCardStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE9D9;" Header="{x:Static frame:Resources.SettingsUiLoadBarsHeader}" Description="{x:Static frame:Resources.SettingsUiLoadBarsDesc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=ShowAccentBars, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE790;" Header="{x:Static frame:Resources.SettingsUiBarColorHeader}" Description="{x:Static frame:Resources.SettingsUiBarColorDesc}" IsEnabled="{Binding Path=AccentColorEnabled}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Swatch}" Background="{Binding Path=AccentColor, Mode=OneWay}" Tag="AccentColor" MouseLeftButtonDown="ColorBorder_MouseLeftButtonDown" ToolTip="{x:Static frame:Resources.SettingsUiPickColorTooltip}" />
                                <TextBox Style="{StaticResource ColorBox}" Text="{Binding Path=AccentColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </local:SettingRow>

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupText}" Style="{StaticResource GroupHeader}" />
                        <local:SettingRow Icon="&#xE8D2;" Header="{x:Static frame:Resources.SettingsUiFontHeader}" Description="{x:Static frame:Resources.SettingsUiFontDesc}">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="190" ItemsSource="{Binding Path=FontFamilyItems, Mode=OneWay}" SelectedValue="{Binding Path=FontOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=Name, Mode=OneWay}" FontFamily="{Binding Path=Family, Mode=OneWay}" FontSize="14" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Width="80" MinWidth="80" Margin="8,0,0,0" ItemsSource="{Binding Path=FontSettingItems, Mode=OneWay}" DisplayMemberPath="FontSize" SelectedValue="{Binding Path=FontSetting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static frame:Resources.SettingsFontSizeTooltip}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE8D3;" Header="{x:Static frame:Resources.SettingsFontColor}" Description="{x:Static frame:Resources.SettingsFontColorTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Swatch}" Background="{Binding Path=FontColor, Mode=OneWay}" Tag="FontColor" MouseLeftButtonDown="ColorBorder_MouseLeftButtonDown" ToolTip="{x:Static frame:Resources.SettingsUiPickColorTooltip}" />
                                <TextBox Style="{StaticResource ColorBox}" Text="{Binding Path=FontColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE8E4;" Header="{x:Static frame:Resources.SettingsUiAlignmentHeader}" Description="{x:Static frame:Resources.SettingsUiAlignmentDesc}">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="130" MinWidth="130" ItemsSource="{Binding Path=TextAlignItems, Mode=OneWay}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding Path=TextAlign, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static frame:Resources.SettingsTextAlignTooltip}" />
                                <ComboBox Width="130" MinWidth="130" Margin="8,0,0,0" ItemsSource="{Binding Path=ContentVerticalAlignItems, Mode=OneWay}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding Path=ContentVerticalAlign, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static frame:Resources.SettingsUiVerticalAlignTooltip}" />
                            </StackPanel>
                        </local:SettingRow>

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupHeader}" Style="{StaticResource GroupHeader}" />
                        <local:SettingRow Icon="&#xE977;" Header="{x:Static frame:Resources.SettingsShowMachineName}" Description="{x:Static frame:Resources.SettingsShowMachineNameTooltip}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=ShowMachineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE823;" Header="{x:Static frame:Resources.SettingsShowClock}" Description="{x:Static frame:Resources.SettingsShowClockTooltip}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=ShowClock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Header="{x:Static frame:Resources.Settings24HourClock}" Description="{x:Static frame:Resources.Settings24HourClockTooltip}" IsEnabled="{Binding Path=ShowClock, Mode=OneWay}" Margin="36,0,0,4">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=Clock24HR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Header="{x:Static frame:Resources.SettingsDateFormat}" Description="{x:Static frame:Resources.SettingsDateFormatTooltip}" IsEnabled="{Binding Path=ShowClock, Mode=OneWay}" Margin="36,0,0,4">
                            <ComboBox Width="220" ItemsSource="{Binding Path=DateSettingItems}" DisplayMemberPath="Display" SelectedValue="{Binding Path=DateSetting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupAlerts}" Style="{StaticResource GroupHeader}" />
                        <local:SettingRow Icon="&#xE7BA;" Header="{x:Static frame:Resources.SettingsAlertFontColor}" Description="{x:Static frame:Resources.SettingsAlertFontColorTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Swatch}" Background="{Binding Path=AlertFontColor, Mode=OneWay}" Tag="AlertFontColor" MouseLeftButtonDown="ColorBorder_MouseLeftButtonDown" ToolTip="{x:Static frame:Resources.SettingsUiPickColorTooltip}" />
                                <TextBox Style="{StaticResource ColorBox}" Text="{Binding Path=AlertFontColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xEA8F;" Header="{x:Static frame:Resources.SettingsAlertBlink}" Description="{x:Static frame:Resources.SettingsAlertBlinkTooltip}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=AlertBlink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= MONITORS ================= -->
            <TabItem Header="{x:Static frame:Resources.SettingsMonitorsTab}" Tag="&#xE9D9;">
                <Grid Margin="20,20,8,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- master: monitor list -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6,10" Margin="0,0,16,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="10,2,8,10">
                                <TextBlock Text="{x:Static frame:Resources.SettingsMonitorsTab}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" Text="{x:Static frame:Resources.SettingsUiMonitorsIntro}" />
                            </StackPanel>
                            <ListBox x:Name="MonitorsList" ItemsSource="{Binding Path=MonitorConfig}" SelectedItem="{Binding Path=SelectedMonitorConfig, Mode=TwoWay}" ItemContainerStyle="{StaticResource MasterItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ItemName" Grid.Column="0" Text="{Binding Path=Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel x:Name="Order" Grid.Column="1" Orientation="Horizontal" Visibility="Hidden">
                                                <Button Style="{StaticResource IconButton}" Width="24" Height="26" FontSize="10" Content="&#xE70E;" Click="MonitorUp_Click" ToolTip="{x:Static frame:Resources.SettingsUiMoveUpTooltip}" />
                                                <Button Style="{StaticResource IconButton}" Width="24" Height="26" FontSize="10" Content="&#xE70D;" Click="MonitorDown_Click" ToolTip="{x:Static frame:Resources.SettingsUiMoveDownTooltip}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchCompact}" Margin="6,0,2,0" IsChecked="{Binding Path=Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static frame:Resources.SettingsMonitorEnabledTooltip}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Order" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Order" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ItemName" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Enabled}" Value="False">
                                                <Setter TargetName="ItemName" Property="Foreground" Value="{StaticResource TextTertiary}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- detail: selected monitor -->
                    <ScrollViewer x:Name="MonitorDetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" DataContext="{Binding Path=SelectedMonitorConfig}">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <DockPanel Margin="2,0,0,14">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Path=Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static frame:Resources.SettingsMonitorEnabledTooltip}" />
                                <TextBlock Text="{Binding Path=Name}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <!-- nothing to configure -->
                            <Border Padding="16,14">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=HardwareOC.Count}" Value="0" />
                                                    <Condition Binding="{Binding Path=Metrics.Length}" Value="0" />
                                                    <Condition Binding="{Binding Path=Params.Length}" Value="0" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{x:Static frame:Resources.SettingsNoExtraOptions}" Style="{StaticResource Caption}" />
                            </Border>

                            <!-- AI providers (AI usage monitor only) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=Type}" Value="{x:Static monitor:MonitorType.AIUsage}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{x:Static frame:Resources.SettingsProvidersHeader}" Style="{StaticResource GroupHeader}" Margin="2,0,0,4" />
                                <TextBlock Text="{x:Static frame:Resources.SettingsUsageNote}" Style="{StaticResource Caption}" Margin="2,0,0,10" />

                                <ItemsControl ItemsSource="{Binding Path=HardwareOC}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="14,10,14,10">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" Background="#0A000000" VerticalAlignment="Center">
                                                            <Path Width="18" Height="18" Stretch="Uniform" Data="{Binding Path=ID, Converter={StaticResource ProviderGeometry}}" Fill="{Binding Path=ID, Converter={StaticResource ProviderBrush}}" />
                                                        </Border>
                                                        <TextBox Grid.Column="1" Style="{StaticResource InlineEdit}" Text="{Binding Path=Name, Mode=TwoWay}" MinWidth="120" Margin="8,0,8,0" VerticalAlignment="Center" ToolTip="{x:Static frame:Resources.SettingsHardwareNameTooltip}" />
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Path=Status, Mode=OneWay}" ToolTip="{Binding Path=Status, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Path=AccountStatus, Mode=OneWay}" ToolTip="{Binding Path=AccountStatus, Mode=OneWay}" Visibility="{Binding Path=AccountStatus, Converter={StaticResource EmptyToCollapsed}}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0">
                                                            <Button Content="&#xE72C;" Click="HardwareClaudeRenew_Click" ToolTip="{x:Static frame:Resources.SettingsUsageClaudeRenewTooltip}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Path=ID}" Value="AIUsage_Claude">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE8FA;" Click="HardwareSignIn_Click" ToolTip="{x:Static frame:Resources.UsageSignInTooltip}" />
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="10" Click="HardwareUp_Click" ToolTip="{x:Static frame:Resources.SettingsUiMoveUpTooltip}" />
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="10" Click="HardwareDown_Click" ToolTip="{x:Static frame:Resources.SettingsUiMoveDownTooltip}" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="4" Style="{StaticResource SwitchCompact}" IsChecked="{Binding Path=Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static frame:Resources.SettingsUsageEnabledTooltip}" />
                                                    </Grid>

                                                    <StackPanel x:Name="Body" Margin="40,8,0,0">
                                                        <ItemsControl ItemsSource="{Binding Path=Bars}" Visibility="{Binding Path=Bars.Count, Converter={StaticResource EmptyToCollapsed}}" ToolTip="{x:Static frame:Resources.SettingsUiHideBarTooltip}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox Style="{StaticResource Chip}" Content="{Binding Path=Label, Mode=OneWay}" IsChecked="{Binding Path=IsOn, Mode=TwoWay}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding Path=RenewStatus, Mode=OneWay}" Visibility="{Binding Path=RenewStatus, Converter={StaticResource EmptyToCollapsed}}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                                        <CheckBox Style="{StaticResource SwitchCompact}" Content="{x:Static frame:Resources.SettingsUsageShowAccount}" ToolTip="{x:Static frame:Resources.SettingsUsageShowAccountTooltip}" IsChecked="{Binding Path=ShowAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />

                                                        <Expander Style="{StaticResource CardExpander}" Header="{x:Static frame:Resources.SettingsUiAdvancedExpander}">
                                                            <StackPanel Margin="18,4,0,2">
                                                                <DockPanel Margin="0,0,0,8">
                                                                    <TextBlock DockPanel.Dock="Left" Text="{x:Static frame:Resources.SettingsUsageCustomPathColumn}" VerticalAlignment="Center" Width="170" />
                                                                    <TextBox Text="{Binding Path=CustomPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{x:Static frame:Resources.SettingsUsageCustomPathTooltip}" />
                                                                </DockPanel>
                                                                <CheckBox x:Name="ShowExtraBox" Style="{StaticResource SwitchCompact}" Content="{x:Static frame:Resources.SettingsUiAgyShowExtra}" Margin="0,0,0,8" Visibility="Collapsed"
                                                                          IsChecked="{Binding Path=ShowExtra, TargetNullValue=True, FallbackValue=True, Mode=TwoWay}" />
                                                                <CheckBox x:Name="AutoRenewBox" Style="{StaticResource SwitchCompact}" Content="{x:Static frame:Resources.SettingsUsageClaudeAutoRenew}" Visibility="Collapsed" IsChecked="{Binding Path=AutoRenew, Mode=TwoWay}" />
                                                            </StackPanel>
                                                        </Expander>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Path=Enabled}" Value="False">
                                                    <Setter TargetName="Body" Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=ID}" Value="AIUsage_Agy">
                                                    <Setter TargetName="ShowExtraBox" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=ID}" Value="AIUsage_Claude">
                                                    <Setter TargetName="AutoRenewBox" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- hardware devices (non AI monitors) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=HardwareOC.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Path=Type}" Value="{x:Static monitor:MonitorType.AIUsage}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{x:Static frame:Resources.SettingsHardwareHeader}" Style="{StaticResource GroupHeader}" Margin="2,0,0,8" />
                                <Border Style="{StaticResource Card}" Padding="8,6">
                                    <ItemsControl ItemsSource="{Binding Path=HardwareOC}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="40" Margin="4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Style="{StaticResource InlineEdit}" FontWeight="Normal" Text="{Binding Path=Name, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{x:Static frame:Resources.SettingsHardwareNameTooltip}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="10" Click="HardwareUp_Click" ToolTip="{x:Static frame:Resources.SettingsUiMoveUpTooltip}" />
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="10" Click="HardwareDown_Click" ToolTip="{x:Static frame:Resources.SettingsUiMoveDownTooltip}" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" Style="{StaticResource SwitchCompact}" IsChecked="{Binding Path=Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static frame:Resources.SettingsHardwareEnabledTooltip}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- metrics -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=Metrics.Length}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{x:Static frame:Resources.SettingsMetricsHeader}" Style="{StaticResource GroupHeader}" />
                                <Border Style="{StaticResource Card}" Padding="14,12,8,6">
                                    <ItemsControl ItemsSource="{Binding Path=Metrics, Mode=OneWay}" ToolTip="{x:Static frame:Resources.SettingsMetricsTooltip}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource Chip}" Content="{Binding Path=Name, Mode=OneWay}" IsChecked="{Binding Path=Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- options & alerts -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=Params.Length}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{x:Static frame:Resources.SettingsAlertsHeader}" Style="{StaticResource GroupHeader}" />
                                <Border Style="{StaticResource Card}" Padding="16,4">
                                    <ItemsControl ItemsSource="{Binding Path=Params}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type monitor:ConfigParam}">
                                                <ContentControl Focusable="False">
                                                    <ContentControl.Style>
                                                        <Style TargetType="{x:Type ContentControl}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TypeString}" Value="System.Boolean">
                                                                    <Setter Property="Content">
                                                                        <Setter.Value>
                                                                            <DockPanel Height="44" Background="Transparent" ToolTip="{Binding Path=Tooltip, Mode=OneTime}">
                                                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCompact}" IsChecked="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                <TextBlock Text="{Binding Path=Name, Mode=OneTime}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                            </DockPanel>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TypeString}" Value="System.Int32">
                                                                    <Setter Property="Content">
                                                                        <Setter.Value>
                                                                            <DockPanel Height="44" Background="Transparent" ToolTip="{Binding Path=Tooltip, Mode=OneTime}">
                                                                                <TextBox DockPanel.Dock="Right" Width="72" HorizontalContentAlignment="Right" Text="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntConverter}}" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding Path=Name, Mode=OneTime}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                            </DockPanel>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= HOTKEYS ================= -->
            <TabItem Header="{x:Static frame:Resources.SettingsHotkeysTab}" Tag="&#xE765;">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="{x:Static frame:Resources.SettingsHotkeysTab}" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="{x:Static frame:Resources.SettingsUiHotkeysIntro}" Style="{StaticResource Caption}" Margin="0,0,0,18" />

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupSidebar}" Style="{StaticResource GroupHeader}" Margin="2,0,0,8" />
                        <local:SettingRow Icon="&#xE8AB;" Header="{x:Static frame:Resources.SettingsHotkeyToggle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="190" Text="{Binding Path=ToggleKey, Mode=OneWay, Converter={StaticResource HotkeyConverter}}" IsReadOnly="True" Margin="0,0,8,0" />
                                <ToggleButton Content="{x:Static frame:Resources.SettingsUiRecord}" Click="BindToggle_Click" LostFocus="BindButton_LostFocus" Style="{StaticResource RecordToggle}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE7B3;" Header="{x:Static frame:Resources.SettingsHotkeyShow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="190" Text="{Binding Path=ShowKey, Mode=OneWay, Converter={StaticResource HotkeyConverter}}" IsReadOnly="True" Margin="0,0,8,0" />
                                <ToggleButton Content="{x:Static frame:Resources.SettingsUiRecord}" Click="BindShow_Click" LostFocus="BindButton_LostFocus" Style="{StaticResource RecordToggle}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xED1A;" Header="{x:Static frame:Resources.SettingsHotkeyHide}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="190" Text="{Binding Path=HideKey, Mode=OneWay, Converter={StaticResource HotkeyConverter}}" IsReadOnly="True" Margin="0,0,8,0" />
                                <ToggleButton Content="{x:Static frame:Resources.SettingsUiRecord}" Click="BindHide_Click" LostFocus="BindButton_LostFocus" Style="{StaticResource RecordToggle}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE90C;" Header="{x:Static frame:Resources.SettingsHotkeyCycleEdge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="190" Text="{Binding Path=CycleEdgeKey, Mode=OneWay, Converter={StaticResource HotkeyConverter}}" IsReadOnly="True" Margin="0,0,8,0" />
                                <ToggleButton Content="{x:Static frame:Resources.SettingsUiRecord}" Click="BindCycleEdge_Click" LostFocus="BindButton_LostFocus" Style="{StaticResource RecordToggle}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE7F4;" Header="{x:Static frame:Resources.SettingsHotkeyCycleScreen}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="190" Text="{Binding Path=CycleScreenKey, Mode=OneWay, Converter={StaticResource HotkeyConverter}}" IsReadOnly="True" Margin="0,0,8,0" />
                                <ToggleButton Content="{x:Static frame:Resources.SettingsUiRecord}" Click="BindCycleScreen_Click" LostFocus="BindButton_LostFocus" Style="{StaticResource RecordToggle}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE718;" Header="{x:Static frame:Resources.SettingsHotkeyReserveSpace}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="190" Text="{Binding Path=ReserveSpaceKey, Mode=OneWay, Converter={StaticResource HotkeyConverter}}" IsReadOnly="True" Margin="0,0,8,0" />
                                <ToggleButton Content="{x:Static frame:Resources.SettingsUiRecord}" Click="BindReserveSpace_Click" LostFocus="BindButton_LostFocus" Style="{StaticResource RecordToggle}" />
                            </StackPanel>
                        </local:SettingRow>

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupApp}" Style="{StaticResource GroupHeader}" />
                        <local:SettingRow Icon="&#xE72C;" Header="{x:Static frame:Resources.SettingsHotkeyReload}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="190" Text="{Binding Path=ReloadKey, Mode=OneWay, Converter={StaticResource HotkeyConverter}}" IsReadOnly="True" Margin="0,0,8,0" />
                                <ToggleButton Content="{x:Static frame:Resources.SettingsUiRecord}" Click="BindReload_Click" LostFocus="BindButton_LostFocus" Style="{StaticResource RecordToggle}" />
                            </StackPanel>
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE711;" Header="{x:Static frame:Resources.SettingsHotkeyClose}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="190" Text="{Binding Path=CloseKey, Mode=OneWay, Converter={StaticResource HotkeyConverter}}" IsReadOnly="True" Margin="0,0,8,0" />
                                <ToggleButton Content="{x:Static frame:Resources.SettingsUiRecord}" Click="BindClose_Click" LostFocus="BindButton_LostFocus" Style="{StaticResource RecordToggle}" />
                            </StackPanel>
                        </local:SettingRow>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= OVERLAY ================= -->
            <TabItem Header="{x:Static frame:Resources.SettingsOverlayTab}" Tag="&#xE7FC;">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="{x:Static frame:Resources.SettingsOverlayTab}" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="{x:Static frame:Resources.SettingsUiOverlayIntro}" Style="{StaticResource Caption}" Margin="0,0,0,14" />

                        <Border CornerRadius="6" Padding="14,10" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="#FFF4CE" />
                                    <Setter Property="BorderBrush" Value="#F2DFA0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=RTSSDetected}" Value="True">
                                            <Setter Property="Background" Value="#DFF6DD" />
                                            <Setter Property="BorderBrush" Value="#B5E3B1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <DockPanel Visibility="{Binding Path=RTSSDetected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="#8A5300" Margin="0,0,10,0" />
                                    <TextBlock TextWrapping="Wrap" Foreground="#5C3B00" Text="{x:Static frame:Resources.SettingsUiRtssNotDetected}" />
                                </DockPanel>
                                <DockPanel Visibility="{Binding Path=RTSSDetected, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Glyph}" Foreground="#0F7B0F" Margin="0,0,10,0" />
                                    <TextBlock TextWrapping="Wrap" Foreground="#0B4A0B" Text="{x:Static frame:Resources.SettingsUiRtssDetected}" />
                                </DockPanel>
                            </Grid>
                        </Border>

                        <local:SettingRow Icon="&#xE7FC;" Header="{x:Static frame:Resources.SettingsUiShowFpsOverlayHeader}" Description="{x:Static frame:Resources.SettingsUiShowFpsOverlayDesc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Path=ShowFpsOverlay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE90C;" Header="{x:Static frame:Resources.SettingsUiOverlayCornerHeader}" Description="{x:Static frame:Resources.SettingsUiOverlayCornerDesc}" IsEnabled="{Binding Path=ShowFpsOverlay, Mode=OneWay}">
                            <ComboBox Width="220" ItemsSource="{Binding Path=OverlayCornerItems, Mode=OneWay}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding Path=FpsOverlayCorner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </local:SettingRow>
                        <local:SettingRow Icon="&#xE706;" Header="{x:Static frame:Resources.SettingsUiOpacityHeader}" Description="{x:Static frame:Resources.SettingsUiOverlayOpacityDesc}" IsEnabled="{Binding Path=ShowFpsOverlay, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Value="{Binding Path=FpsOverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.2" Maximum="1.0" TickFrequency="0.01" IsSnapToTickEnabled="True" LargeChange="0.1" />
                                <TextBox Style="{StaticResource NumBox}" Text="{Binding Path=FpsOverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" PreviewTextInput="NumberBox_PreviewTextInput" />
                                <TextBlock Text="" Style="{StaticResource Unit}" />
                            </StackPanel>
                        </local:SettingRow>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= ABOUT ================= -->
            <TabItem Header="{x:Static frame:Resources.SettingsUiAboutTab}" Tag="&#xE946;">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="{x:Static frame:Resources.SettingsUiAboutTab}" Style="{StaticResource PageTitle}" />

                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="10" Background="{StaticResource Accent}" Margin="0,0,16,0">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="22" Foreground="White" />
                                </Border>
                                <Button DockPanel.Dock="Right" Click="CheckUpdate_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{x:Static frame:Resources.SettingsUiCheckForUpdates}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static frame:Resources.AppName}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{x:Static frame:Resources.SettingsUiGroupSupport}" Style="{StaticResource GroupHeader}" Visibility="{Binding Path=IsReportFeatureAvailable, Converter={StaticResource BoolToVisibility}}" />
                        <local:SettingRow Icon="&#xE90F;" Header="{x:Static frame:Resources.SettingsUiSendLogHeader}" Description="{x:Static frame:Resources.SettingsUiSendLogDesc}" Visibility="{Binding Path=IsReportFeatureAvailable, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="{x:Static frame:Resources.SettingsUiSendReport}" Click="SendLog_Click" />
                        </local:SettingRow>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </DockPanel>
        <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#B3EEF0F3" CornerRadius="0,0,5,5" IsHitTestVisible="True">
            <Border Style="{StaticResource Card}" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="260">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,0,0,12" Foreground="{StaticResource Accent}" Background="#22000000" BorderThickness="0" />
                    <TextBlock Text="{x:Static frame:Resources.SettingsUiApplyingChanges}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</sty:FlatWindow>
